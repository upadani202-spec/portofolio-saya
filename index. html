            document.getElementById('id-hobi').value = id.hobi;
            document.getElementById('id-alamat').value = id.alamat;
            document.getElementById('id-tagline').value = id.tagline;
            openModal('modal-identity-form');
        }

        function saveIdentityData(e) {
            e.preventDefault();
            portfolioData.identity = {
