        function openSectionModal(type) {
            const cfg = sectionConfigs[type];
            document.getElementById('sec-type').value = type;
            document.getElementById('section-modal-title').textContent = `Kelola ${cfg.title}`;
            document.getElementById('label-field-1').textContent = cfg.f1;
            document.getElementById('label-field-2').textContent = cfg.f2;
            document.getElementById('label-field-3').textContent = cfg.f3;
            document.getElementById('label-field-4').textContent = cfg.f4;

            resetSectionForm();
            renderModalExistingList(type);
            openModal('modal-section');
        }

        function resetSectionForm() {
            document.getElementById('sec-edit-index').value = "-1";
            document.getElementById('sec-field-1').value = "";
            document.getElementById('sec-field-2').value = "";
            document.getElementById('sec-field-3').value = "";
            document.getElementById('sec-field-4').value = "";
            document.getElementById('btn-cancel-edit').classList.add('hidden');
            document.getElementById('btn-submit-section').innerHTML = '<i class="fa-solid fa-plus mr-1"></i>Tambah Data';
        }

        function renderModalExistingList(type) {
            const list = portfolioData.sections[type];
            const container = document.getElementById('modal-existing-list');
            if (!list.length) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">Belum ada data tersimpan.</p>`;
                return;
            }
            container.innerHTML = list.map((item, idx) => `
                <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-bold text-slate-800 truncate">${escapeHTML(item.f1)}</p>
                        <p class="text-[11px] text-slate-500 truncate">${escapeHTML(item.f2)} • ${escapeHTML(item.f3)}</p>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button type="button" onclick="editSectionItem('${type}', ${idx})" class="w-7 h-7 rounded-lg bg-amber-100 hover:bg-amber-500 text-amber-700 hover:text-white flex items-center justify-center text-xs transition-colors" title="Edit">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button type="button" onclick="deleteSectionItem('${type}', ${idx})" class="w-7 h-7 rounded-lg bg-rose-100 hover:bg-rose-500 text-rose-700 hover:text-white flex items-center justify-center text-xs transition-colors" title="Hapus">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function editSectionItem(type, index) {
            const item = portfolioData.sections[type][index];
            document.getElementById('sec-edit-index').value = index;
            document.getElementById('sec-field-1').value = item.f1;
            document.getElementById('sec-field-2').value = item.f2;
            document.getElementById('sec-field-3').value = item.f3;
            document.getElementById('sec-field-4').value = item.f4 || "";
            document.getElementById('btn-cancel-edit').classList.remove('hidden');
            document.getElementById('btn-submit-section').innerHTML = '<i class="fa-solid fa-check mr-1"></i>Update Data';
        }

        function deleteSectionItem(type, index) {
            portfolioData.sections[type].splice(index, 1);
            saveToStorage();
            renderAllSections();
            renderModalExistingList(type);
            resetSectionForm();
            showToast('Item berhasil dihapus.', 'info');
        }

        function saveSectionItem(e) {
            e.preventDefault();
            const type = document.getElementById('sec-type').value;
            const editIdx = parseInt(document.getElementById('sec-edit-index').value, 10);

            const newItem = {
                f1: document.getElementById('sec-field-1').value.trim(),
                f2: document.getElementById('sec-field-2').value.trim(),
                f3: document.getElementById('sec-field-3').value.trim(),
                f4: document.getElementById('sec-field-4').value.trim()
            };

            if (editIdx >= 0) {
                portfolioData.sections[type][editIdx] = newItem;
                showToast('Data berhasil diperbarui!', 'success');
            } else {
                portfolioData.sections[type].unshift(newItem);
                showToast('Data baru berhasil ditambahkan!', 'success');
            }

            saveToStorage();
            renderAllSections();
            renderModalExistingList(type);
            resetSectionForm();
        }

