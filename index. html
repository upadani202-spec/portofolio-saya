        function openPhotoModal() {
            document.getElementById('photo-url-input').value = '';
            document.getElementById('photo-file-input').value = '';
            openModal('modal-photo');
        }

        function savePhoto(e) {
            e.preventDefault();
            const fileInput = document.getElementById('photo-file-input');
            const urlInput = document.getElementById('photo-url-input').value.trim();

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    portfolioData.photo = event.target.result;
                    saveToStorage();
                    renderProfileAndContact();
                    closeModal('modal-photo');
                    showToast('Foto profil berhasil diperbarui!', 'success');
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else if (urlInput) {
                portfolioData.photo = urlInput;
                saveToStorage();
                renderProfileAndContact();
                closeModal('modal-photo');
                showToast('Foto profil berhasil diperbarui!', 'success');
            } else {
                showToast('Pilih file gambar atau masukkan URL terlebih dahulu.', 'error');
            }
        }

