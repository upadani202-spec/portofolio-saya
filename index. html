                document.getElementById('token-input').value = '';
                document.getElementById('token-error').classList.add('hidden');
                openModal('modal-token');
                setTimeout(() => document.getElementById('token-input').focus(), 100);
            }
        }

        function toggleTokenVisibility() {
            const input = document.getElementById('token-input');
            const icon = document.getElementById('token-eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function verifyToken(e) {
            e.preventDefault();
            const entered = document.getElementById('token-input').value.trim();
            if (entered === ACCESS_TOKEN) {
                isIdentityUnlocked = true;
                closeModal('modal-token');
                
                // Update ikon gembok di navbar
                const lockIcon = document.getElementById('lock-status-icon');
                lockIcon.classList.remove('fa-lock', 'text-amber-400');
                lockIcon.classList.add('fa-lock-open', 'text-emerald-400');

                // Tampilkan panel identitas
                const panel = document.getElementById('identity-panel');
                panel.classList.remove('hidden');
                panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                showToast('Akses identitas berhasil dibuka!', 'success');
            } else {
                document.getElementById('token-error').classList.remove('hidden');
            }
        }

        function lockIdentityPanel() {
            isIdentityUnlocked = false;
            document.getElementById('identity-panel').classList.add('hidden');
            const lockIcon = document.getElementById('lock-status-icon');
            lockIcon.classList.remove('fa-lock-open', 'text-emerald-400');
            lockIcon.classList.add('fa-lock', 'text-amber-400');
            showToast('Menu identitas dikunci kembali.', 'info');
        }

        function openIdentityFormModal() {
