    <div id="modal-token" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-100 transform transition-all">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <button onclick="closeModal('modal-token')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900">Akses Menu Identitas</h3>
            <p class="text-sm text-slate-500 mt-1">Masukkan token atau password keamanan untuk membuka dan mengisi data identitas pribadi.</p>
            
            <form onsubmit="verifyToken(event)" class="mt-5 space-y-4">
                <div>
                    <label for="token-input" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Token / Password</label>
                    <div class="relative">
                        <input type="password" id="token-input" required placeholder="Masukkan token akses..." 
                               class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-primary-600 focus:ring-2 focus:ring-primary-500/20 outline-none text-sm transition-all pr-10">
                        <button type="button" onclick="toggleTokenVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                            <i id="token-eye-icon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <p id="token-error" class="hidden text-xs text-rose-600 font-medium mt-1.5">
                        <i class="fa-solid fa-circle-exclamation mr-1"></i>Token/Password salah! Silakan coba lagi.
                    </p>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('modal-token')" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-all">Batal</button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold shadow-sm transition-all">Buka Identitas</button>
                </div>
            </form>
